# ZOZ Pro Content Factory integration
# Set these in the ZOZ Pro server's secret/environment settings, never in browser storage.
# Use the exact Upload-Post profile name returned by list_users:
# ZozAI -> YouTube @zozai-q6z (ZOZ Ai brand channel)
# ZozAI2 -> YouTube @hazemelzoz7281 (Hazem Ahmed channel)
UPLOAD_POST_API_KEY=
UPLOAD_POST_PROFILE=ZozAI

# Public HTTPS origin that serves the approved studio output URL:
# https://<studio-host>/outputs/<jobId>/video.mp4
ZOZ_CONTENT_STUDIO_URL=

# Keep false until source URL access and Upload-Post credentials/profile have been verified.
ZOZ_PRO_PUBLISHING_ENABLED=false

# Isolated ZP-018 Preview control token. Configure the same independently generated
# secret in Vercel Preview for branch fix/ZP-018-serialized-state-writes and in the
# GitHub Actions environment preview-smoke as ZOZ_PRO_PREVIEW_CONTROL_TOKEN.
# The application only accepts this token on that exact Vercel Preview branch.
ZOZ_PRO_PREVIEW_CONTROL_TOKEN=
