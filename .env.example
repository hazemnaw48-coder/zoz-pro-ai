# ZOZ Pro Content Factory integration
# Set these in the ZOZ Pro server's secret/environment settings, never in browser storage.
# Use the exact Upload-Post profile name returned by list_users:
# ZozAI -> YouTube @zozai-q6z (ZOZ Ai brand channel)
# ZozAI2 -> YouTube @hazemelzoz7281 (Hazem Ahmed channel)
UPLOAD_POST_API_KEY=
UPLOAD_POST_PROFILE=ZozAI

# Public HTTPS origin that serves the approved studio output URL:
# https://<studio-host>/outputs/<jobId>/video.mp4
ZOZ_CONTENT_STUDIO_URL=

# Keep false until source URL access and Upload-Post credentials/profile have been verified.
ZOZ_PRO_PUBLISHING_ENABLED=false

# Google Cloud Run target: in-band execution, no polling service or external queue.
# Set these only in server-side Cloud Run environment settings / Secret Manager.
ZOZ_PRO_EXECUTION_RUNTIME=cloud-run-inband
ZOZ_PRO_STATE_BACKEND=supabase
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional backward-compatible server-only alias; prefer SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
ZOZ_CONTROL_TOKEN=
GEMINI_API_KEY=
# Bounded recovery scan; the worker caps this at 10 commands per sweep.
ZOZ_PRO_WORKER_SWEEP_LIMIT=10

# Supabase Edge Functions owner allowlist (set in Supabase secrets; never commit the real address)
ZOZ_OWNER_EMAIL=owner@example.invalid
