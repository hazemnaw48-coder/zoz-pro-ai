{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 60
    },
    "api/cron/heartbeat.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/heartbeat",
      "schedule": "0 3 * * *"
    }
  ]
}
